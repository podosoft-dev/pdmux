{
  "name": "@pdmux/protocol",
  "version": "0.11.2",
  "type": "module",
  "description": "Agent<->server contract for pdmux: zod schemas and types shared by api, web and agent.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "conformance"
  ],
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.json",
    "test": "bunx --bun vitest run",
    "lint": "bunx --bun tsc -p tsconfig.json --noEmit",
    "schema:build": "bun scripts/build-schema.mjs",
    "schema:check": "bun scripts/build-schema.mjs --check",
    "expect:build": "bun scripts/build-expected.mjs",
    "expect:check": "bun scripts/build-expected.mjs --check"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^2.1.8",
    "zod-to-json-schema": "^3.24.6"
  }
}
