{
  "name": "@pdmux/ui",
  "version": "0.3.1",
  "type": "module",
  "description": "Svelte 5 components for pdmux: host cards, metric sparklines, terminal grid and read-only commit graph. Data comes in as props; no app coupling.",
  "license": "Apache-2.0",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run",
    "test:geometry": "PDMUX_BROWSER_TEST=1 playwright test -c test/playwright.config.ts",
    "lint": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js"
  },
  "peerDependencies": {
    "svelte": "^5.1.0"
  },
  "dependencies": {
    "@pdmux/core": "0.3.1",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8",
    "@vitest/browser": "^2.1.8",
    "jsdom": "^25.0.1",
    "@testing-library/svelte": "^5.2.6",
    "vite": "^5.4.0"
  }
}
