# Copy to .env next to your compose invocation and fill in the marked values.
#   cp infra/docker/selfhost.env.example .env

# The release to run. Pin it rather than tracking a moving tag — the agent update
# path and any rollback both compare exact versions.
PDMUX_VERSION=v0.3.1

# The name people reach pdmux by. Everything is served over HTTPS and Caddy obtains
# the certificate itself, so this has to be a name that resolves to this machine and
# whose ports 80 and 443 are reachable from the internet.
#
# `localhost` works for a look around: Caddy signs with its own local CA and the
# browser warns once. Agents on other machines cannot reach a localhost, so that is a
# trial rather than a deployment.
PDMUX_DOMAIN=localhost

# The first account registered with one of these addresses becomes an administrator.
ADMIN_EMAILS=you@example.com

# --- fill these in -----------------------------------------------------------

# 32 characters or more. Settings encrypted in the database (OAuth secrets, SMTP
# passwords) are unlocked with this, so keep a copy wherever you keep the backup:
# lose it and those values cannot be decrypted.
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

POSTGRES_PASSWORD=

# Credentials for the bundled MinIO. Point S3_ENDPOINT elsewhere in the compose file
# if you already run S3-compatible storage.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- defaults you rarely change ----------------------------------------------

POSTGRES_USER=pdmux
POSTGRES_DB=pdmux
S3_BUCKET=pdmux
S3_REGION=us-east-1

# Where Caddy listens. Change these only if something else already owns 80/443 — and
# note that Let's Encrypt validation needs port 80 to be reachable as 80 from outside,
# whatever it is mapped to here.
PDMUX_HTTP_PORT=80
PDMUX_HTTPS_PORT=443
