# Copy to .env and adjust. Never commit real secrets.

# ── Required (runtime) ───────────────────────────────────────────────
NODE_ENV=development
PORT=5002
# Address the API listens on (default 0.0.0.0); 127.0.0.1 keeps it off the network.
# HOST=0.0.0.0

# Canonical database connection. Set this for PostgreSQL or SQLite; POSTGRES_* remains a fallback.
# DATABASE_URL=postgres://pdmux:pdmux@localhost:5440/pdmux
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_USER=pdmux
POSTGRES_PASSWORD=pdmux
POSTGRES_DB=pdmux

# PostgreSQL pools. Each API replica opens up to DB_POOL_MAX connections for
# queries, plus DB_AUTH_POOL_MAX for the auth module when it is installed. Keep
# replicas x (DB_POOL_MAX + DB_AUTH_POOL_MAX), plus a few for migrations, below
# the server's max_connections (100 by default). The timeouts are milliseconds.
# DB_QUERY_TIMEOUT_MS bounds how long a query waits for a server that stopped
# answering; migrations and maintenance commands are not bounded.
# DB_POOL_MAX=20
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000
# DB_QUERY_TIMEOUT_MS=10000
# DB_AUTH_POOL_MAX=10
# pdmux's TypeORM pool, which the API and the worker each open besides the two
# above. Count it in that sum too; a deployment profile lists it in
# dependencies.postgres.appPools with sizeKey PDMUX_DB_POOL_MAX.
# PDMUX_DB_POOL_MAX=10

# Largest API request body in bytes (Bun's default is 128 MiB). Requests through
# the web app's /api proxy are also bounded by BODY_SIZE_LIMIT below.
# API_MAX_REQUEST_BODY_SIZE=134217728
# Seconds the API keeps a silent connection open (0 to 255, 0 turns it off). Keep
# it, like CONNECTION_IDLE_TIMEOUT below, more than 4 above the longest /api proxy
# deadline in seconds.
# API_IDLE_TIMEOUT=35

# Reverse proxies in front of the API whose X-Forwarded-For names the caller. The
# web app's /api proxy is one, so 1 records the browser's address for sessions,
# audit entries, and rate limits; 0 uses the socket peer. Count only proxies that
# every request passes: with 1, a caller that reaches the API directly chooses
# its own recorded address.
TRUSTED_PROXY_HOPS=1
# TRUSTED_PROXY_HEADER=x-forwarded-for

# Readiness (GET /health/ready): the longest one dependency check may run, and how
# long a result is reused across probes (0 checks on every request).
# READINESS_CHECK_TIMEOUT_MS=800
# READINESS_CACHE_MS=2000

# Web -> API boundary (server-side only; not exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:5002
# Milliseconds one server-side API call may take, and how long the /api proxy
# waits for response headers (504 BACKEND_TIMEOUT after the second value). When
# the API's GET /health does not answer within BACKEND_TIMEOUT_MS either, API
# calls fail at once until it does. Raise BACKEND_PROXY_TIMEOUT_MS together with
# API_IDLE_TIMEOUT above and CONNECTION_IDLE_TIMEOUT below.
# BACKEND_TIMEOUT_MS=2000
# BACKEND_PROXY_TIMEOUT_MS=30000

CORS_ORIGIN=http://localhost:5001
# Web request limit; leave room for a 2 MiB multipart upload
BODY_SIZE_LIMIT=3M
# Seconds the built web server keeps a silent connection open (0 to 255, 0 turns
# it off). Keep it more than 4 above the longest /api proxy deadline in seconds,
# BACKEND_PROXY_TIMEOUT_MS or APP_PROXY_TIMEOUTS; the proxy refuses to load otherwise.
# pdmux turns it off: file transfers have no proxy deadline, because a commit can
# wait five minutes for the agent (docs/FILE-TRANSFERS.md).
CONNECTION_IDLE_TIMEOUT=0

# ── Optional / development ───────────────────────────────────────────
# Provider overrides. The desktop shell sets SQLite, memory, local files, and
# local jobs explicitly; self-hosted servers normally keep the defaults.
# DATABASE_PROVIDER=postgres
# CACHE_PROVIDER=redis
# OBJECT_STORAGE_PROVIDER=s3
# EVENTS_PROVIDER=redis
# JOBS_PROVIDER=bullmq
# With SQLite and no DATABASE_URL, the database file, relative to apps/api.
# SQLITE_PATH=./data/podokit.sqlite

# Redis — only needed by cache/queue modules (redis, bullmq, rate-limit,
# job-progress, sse). Start it with: docker compose --profile cache up
REDIS_HOST=localhost
REDIS_PORT=6390
# REDIS_URL takes precedence over the individual settings below.
# REDIS_URL=rediss://user:password@cache.example.com:6380/0
REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_TLS=false
# Longest wait in milliseconds for Redis to answer one command. A command that
# gets no reply in time fails, and its connection is closed and reopened.
# REDIS_COMMAND_TIMEOUT_MS=1000

# ── Mailer (SMTP) — optional ──
# With auth installed, configure SMTP on the admin Settings page (stored
# encrypted in the DB, applied live). These env vars are a fallback/override;
# with no SMTP configured at all the mailer logs messages to the console.
# Local dev uses Mailpit: docker compose --profile dev up → http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1035
MAIL_FROM="pdmux <no-reply@example.com>"

# ── Auth (Better Auth) — required secrets ──
# BETTER_AUTH_SECRET also derives the key that encrypts config secrets stored in the
# DB (OAuth client secrets, SMTP password). Keep it stable and secret; rotating it
# makes previously saved DB secrets undecryptable.
BETTER_AUTH_SECRET=change-me-in-production-min-32-characters
BETTER_AUTH_URL=http://localhost:5002
# The name authenticator apps and passkey prompts show. Unset, it is the site
# name from the admin Settings, then the project name.
# AUTH_APP_NAME=
# Everything below is optional. OAuth providers, SMTP, and server-enforced
# toggles are configured on the admin Settings page and applied without restart.
# Email/SMTP is provided by the mailer module (see its .env block).
SMS_WEBHOOK_URL=http://localhost:8095/sms
# AUTH_HIBP=false
# AUTH_EMAIL_VERIFICATION=false
# AUTH_REQUIRE_SIGNUP_APPROVAL=false
# AUTH_ALLOW_DELETE=false
# AUTH_SESSION_IDLE_TIMEOUT_MINUTES=30
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# object storage — STORAGE_PROVIDER: minio | aws
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=pdmux
S3_ACCESS_KEY_ID=pdmux
S3_SECRET_ACCESS_KEY=pdmuxsecret
S3_FORCE_PATH_STYLE=true
# Local object storage root (object-storage=local). Use an absolute path in
# production and desktop packaging.
# LOCAL_STORAGE_PATH=./data/files
# Seconds an unfinished multipart upload may sit idle before its parts are
# removed (object-storage=local).
# LOCAL_STORAGE_MULTIPART_MAX_AGE=86400

# admin-dashboard: administrator emails (comma-separated). An account with one becomes an
# admin when admin:bootstrap creates it or a sign-in verifies the address; an email and
# password sign-up with one is refused. A production API refuses placeholders (example.com).
ADMIN_EMAILS=admin@example.com,pdmux-e2e@example.com

# audit-log: on unless switched off. Managed on the admin Settings page,
# stored in the DB, and applied without restart; this value applies until an
# administrator saves the setting. Set it to false to start with the log off.
AUDIT_LOG_ENABLED=true
# audit-log: delete entries older than this many days. Unset or 0 keeps them
# forever; set it only when your retention policy requires deleting them.
AUDIT_LOG_RETENTION_DAYS=0

# redis uses REDIS_URL or the REDIS_HOST / REDIS_PORT / REDIS_USERNAME / REDIS_PASSWORD / REDIS_DB settings defined above

# api keys for machine clients (comma-separated)
API_KEYS=dev-agent-key-change-me

# rate limit (window in seconds, max requests per identity)
RATE_LIMIT_KEY_PREFIX=podokit:rate-limit
# The e2e suite drives one browser through hundreds of requests from a single
# client, so development uses a short window and a high ceiling. Production
# should use values such as TTL=60 and MAX=300.
RATE_LIMIT_TTL=5
RATE_LIMIT_MAX=2000
# stricter ceiling for authentication writes (admin reads use RATE_LIMIT_MAX)
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_MAX=20
# higher ceiling for SSR runtime settings and session reads
RATE_LIMIT_RUNTIME_MAX=1000
RATE_LIMIT_STORAGE_TIMEOUT_MS=1000
RATE_LIMIT_UNAVAILABLE_RETRY_AFTER=1

# Maximum encoded Server-Sent Event payload
SSE_MAX_EVENT_BYTES=65536
# Open event streams per user on each API replica
SSE_MAX_STREAMS_PER_USER=8
# Redis channel shared by every API replica for events (events=redis)
EVENTS_REDIS_CHANNEL=podokit:events

# bullmq uses REDIS_URL or the individual Redis settings defined above

# Agent releases — where the API reads `<version>/manifest.json` plus binaries.
# `bun run build:agent` writes the default development tree under
# `apps/web/static/agent`. Set this when the API runs from a separate image or
# filesystem and mount the same immutable release tree there.
# AGENT_RELEASE_DIR=/srv/pdmux/agent

# Private, persistent folder-download spool (never serve it statically).
# FILE_TRANSFER_DIR=data/file-transfers
# FILE_TRANSFER_MAX_BYTES=10737418240
# FILE_TRANSFER_MAX_ENTRIES=10000
# FILE_TRANSFER_SPOOL_BYTES=21474836480

# logging
LOG_LEVEL=info

# Local development port overrides. They keep pdmux isolated from services using
# the common PostgreSQL, Redis, MinIO, Mailpit, and SMS sink ports.
S3_PORT=9010
S3_CONSOLE_PORT=9011
SMTP_PORT=1035
MAILPIT_UI_PORT=8035
SMS_SINK_PORT=8095

# e2e catchers
MAILPIT_URL=http://localhost:8035
SMS_SINK_URL=http://localhost:8095

# Extra hostnames Vite may answer in development (comma-separated). Keep this
# empty unless a tunnel or reverse proxy has an explicitly known hostname.
DEV_ALLOWED_HOSTS=

LOCAL_JOBS_POLL_INTERVAL_MS=250
