# Copy to .env and adjust. Never commit real secrets.

# ── Required (runtime) ───────────────────────────────────────────────
NODE_ENV=development
PORT=5002

POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_USER=pdmux
POSTGRES_PASSWORD=pdmux
POSTGRES_DB=pdmux

# Web -> API boundary (server-side only; not exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:5002

# Exact paths the web server may proxy as WebSocket upgrades to the API, comma
# separated. Empty means none: a SvelteKit route cannot answer an upgrade, so a
# WebSocket gateway on the API is unreachable until it is named here. Each path is
# matched whole and must be authorised by the API at handshake time -- a relay that
# forwards anything is an open tunnel to every private route.
WS_PROXY_PATHS=
CORS_ORIGIN=http://localhost:5001
# adapter-node request limit; leave room for a 2 MiB multipart upload
BODY_SIZE_LIMIT=3M

# ── Optional / development ───────────────────────────────────────────
# Redis — only needed by cache/queue modules (redis, bullmq, rate-limit,
# job-progress, sse). Start it with: docker compose --profile cache up
REDIS_HOST=localhost
REDIS_PORT=6390
# REDIS_URL takes precedence over the individual settings below.
# REDIS_URL=rediss://user:password@cache.example.com:6380/0
REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_TLS=false

# ── Mailer (SMTP) — optional ──
# With auth installed, configure SMTP on the admin Settings page (stored
# encrypted in the DB, applied live). These env vars are a fallback/override;
# with no SMTP configured at all the mailer logs messages to the console.
# Local dev uses Mailpit: docker compose --profile dev up → http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1035
MAIL_FROM="pdmux <no-reply@example.com>"

# ── Auth (better-auth) — the only required secrets ──
# BETTER_AUTH_SECRET also derives the key that encrypts config secrets stored in the
# DB (OAuth client secrets, SMTP password). Keep it stable and secret; rotating it
# makes previously-saved DB secrets undecryptable.
BETTER_AUTH_SECRET=change-me-in-production-min-32-characters
BETTER_AUTH_URL=http://localhost:5002
# Everything below is OPTIONAL. OAuth providers, SMTP, and the server-enforced
# toggles (email verification, sign-up approval, breached-password check, self-delete) — plus the
# feature flags — are configured on the admin Settings page, stored encrypted in
# the DB and applied live (no restart). These env vars still work as a fallback/
# override (e.g. for secrets-manager injection in production); the DB takes
# precedence when set.
# --- Optional overrides / local development ---
# Email/SMTP is provided by the mailer module (see its .env block).
# Phone-number SMS webhook (dev: SMS sink on port 8095)
SMS_WEBHOOK_URL=http://localhost:8095/sms
# AUTH_HIBP=false
# AUTH_EMAIL_VERIFICATION=false
# AUTH_REQUIRE_SIGNUP_APPROVAL=false
# AUTH_ALLOW_DELETE=false
# AUTH_SESSION_IDLE_TIMEOUT_MINUTES=30
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# object storage — STORAGE_PROVIDER: minio | aws
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=pdmux
S3_ACCESS_KEY_ID=pdmux
S3_SECRET_ACCESS_KEY=pdmuxsecret
S3_FORCE_PATH_STYLE=true

# admin-dashboard: emails auto-promoted to the admin role on sign-up (comma-separated)
ADMIN_EMAILS=admin@example.com,pdmux-e2e@example.com

# audit-log: on/off is managed on the admin Settings page (stored in the DB,
# applied live, no restart). This env var is the fallback default used until an
# admin sets it — leave it 'true' so the trail is on out of the box; the DB value
# (Settings page) overrides it once set.
AUDIT_LOG_ENABLED=true

# api keys for machine clients (comma-separated)
API_KEYS=dev-agent-key-change-me

# redis uses REDIS_URL or the REDIS_HOST / REDIS_PORT / REDIS_USERNAME / REDIS_PASSWORD / REDIS_DB settings defined above

# Server-Sent Events transport: memory for one API replica, redis for multiple replicas
SSE_TRANSPORT=memory
SSE_REDIS_CHANNEL=podokit:events
SSE_MAX_EVENT_BYTES=65536

# bullmq uses REDIS_URL or the individual Redis settings defined above

# rate limit (window in seconds, max requests per window per client)
# The e2e suite drives one browser through hundreds of requests from a single
# client, so a production-sized window starves later specs: measured 298
# rejections in one pass, which surfaced as a dozen unrelated UI failures that
# moved around between runs. Development therefore runs a short window and a
# high ceiling; production should use something like TTL=60, MAX=100.
#
# The limiter itself is exercised in its own configuration, because a spec that
# has to cross the limit needs a small one:
#   RATE_LIMIT_MAX=20 npm run test:e2e:api   (restart the API first)
RATE_LIMIT_TTL=5
RATE_LIMIT_MAX=2000
# stricter authentication endpoint ceiling
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_MAX=20
# higher ceiling for SSR runtime settings reads (maintenance, sign-up, branding)
RATE_LIMIT_RUNTIME_MAX=1000
# trust no proxy hop by default; set the exact production proxy depth
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
RATE_LIMIT_PROXY_HEADER=x-forwarded-for
RATE_LIMIT_STORAGE_TIMEOUT_MS=1000
RATE_LIMIT_UNAVAILABLE_RETRY_AFTER=1

# agent releases — where the API reads the published agent builds from.
#
# `npm run build:agent` writes `<root>/<version>/manifest.json` (plus the binaries)
# under apps/web/static/agent, and the web tier serves that tree at /agent/<v>/….
# The API reads the same manifests to answer "is this host behind" and to fill in
# an update command. Unset, it falls back to the checkout's own copy, which is
# right for `npm run dev`, the compose stack and a single-container image.
#
# SET IT when the API runs from its own image: that image does not contain the web
# workspace, so point this at the release tree (a mounted volume, usually). With no
# readable tree there is simply no release — every host reads as `unknown` (never a
# false "outdated") and an update request answers 409 with the reason.
# AGENT_RELEASE_DIR=/srv/pdmux/agent

# logging
LOG_LEVEL=info

# ── local dev port overrides (this workstation already uses 5432/6379/9000/9001/8080/80)
S3_PORT=9010
S3_CONSOLE_PORT=9011
SMTP_PORT=1035
MAILPIT_UI_PORT=8035
SMS_SINK_PORT=8095

# e2e helpers: the catchers moved off the default ports (already in use here)
MAILPIT_URL=http://localhost:8035
SMS_SINK_URL=http://localhost:8095

# Extra hostnames `vite dev` will answer to (comma-separated; a leading dot covers
# subdomains). Needed when the dashboard is reached through a tunnel or a reverse
# proxy in development — without it Vite answers 403 "Blocked request". Unused by
# the built server, which does not police the Host header this way.
DEV_ALLOWED_HOSTS=
