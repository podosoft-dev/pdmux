# podo dev generated compose overlay
.podokit/runtime/

# Released agent artifacts, produced by `bun run build:agent`.
#
# The four binaries do not belong in Git: each release adds about 32 MB of blobs,
# while CI and the container build both reproduce them from the pinned Go toolchain.
# Keep the small manifest and checksum record so a rebuild remains verifiable.
# Directories must be re-included before the two metadata allow rules can match.
apps/web/static/agent/**
!apps/web/static/agent/**/
!apps/web/static/agent/**/manifest.json
!apps/web/static/agent/**/SHA256SUMS

# Deployment profiles name private hosts and paths. Only image repositories are
# safe to publish through the deliberately minimal publish profile.
.podokit/deploy/*.json
!.podokit/deploy/publish.json
