{
  "name": "pdmux-web",
  "version": "0.11.4",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev --port 5001",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "lint": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
    "test": "bunx --bun vitest run"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.23.0",
    "@pdmux/core": "workspace:*",
    "@pdmux/protocol": "workspace:*",
    "@pdmux/ui": "workspace:*",
    "@podosoft/podokit-api-client": "^0.8.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "1.0.0-next.1",
    "@sveltejs/kit": "3.0.0-next.25",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typesafe-i18n": "^5.26.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "tw-animate-css": "^1.4.0",
    "@types/qrcode": "^1.5.5"
  }
}
