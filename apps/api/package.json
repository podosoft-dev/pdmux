{
  "name": "pdmux-api",
  "version": "0.10.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --builder swc",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "migrate:all": "node dist/migrate",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:generate": "npm run typeorm -- migration:generate",
    "auth:configure": "node scripts/configure-auth.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "start:worker": "node dist/main-worker",
    "dev:worker": "nest start --watch --builder swc --entryFile main-worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@better-auth/api-key": "^1.6.23",
    "@better-auth/oauth-provider": "^1.6.23",
    "@better-auth/passkey": "^1.6.23",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@pdmux/core": "*",
    "@pdmux/mcp": "^0.10.0",
    "@pdmux/protocol": "*",
    "@podosoft/podokit-auth": "^0.3.0",
    "@podosoft/podokit-contracts": "^0.4.0",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "image-size": "^2.0.2",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^7.0.9",
    "pg": "^8.12.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/testing": "^11.1.27",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.0",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "chokidar": "^3.6.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@pdmux/core$": "<rootDir>/../../../packages/core/src/index.ts",
      "^@pdmux/mcp$": "<rootDir>/testing/pdmux-mcp.stub.ts",
      "^@pdmux/protocol$": "<rootDir>/../../../packages/protocol/src/index.ts",
      "^@thallesp/nestjs-better-auth$": "<rootDir>/testing/nestjs-better-auth.stub.ts"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
