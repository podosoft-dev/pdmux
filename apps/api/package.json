{
  "name": "pdmux-api",
  "version": "0.12.1",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun scripts/build.mjs",
    "start": "bun dist/main.js",
    "lint": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "contract": "bun scripts/verify-api-contract.ts",
    "migrate:all": "bun dist/migrate.js",
    "typeorm": "bunx typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "bun run typeorm -- migration:run",
    "migration:revert": "bun run typeorm -- migration:revert",
    "migration:generate": "bun run typeorm -- migration:generate",
    "auth:configure": "bun scripts/configure-auth.mjs",
    "admin:bootstrap": "bun scripts/bootstrap-admin.mjs",
    "start:worker": "bun dist/main-worker.js",
    "dev:worker": "bun --watch src/main-worker.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pdmux/core": "workspace:*",
    "@pdmux/mcp": "workspace:*",
    "@pdmux/protocol": "workspace:*",
    "@podosoft/podokit-contracts": "^0.4.0",
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.15",
    "dotenv": "^16.4.5",
    "elysia": "^1.4.29",
    "pg": "^8.12.0",
    "pino": "^9.6.0",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8",
    "nodemailer": "^9.0.5",
    "@podosoft/podokit-auth": "^0.3.0",
    "better-auth": "^1.7.1",
    "@better-auth/api-key": "^1.7.1",
    "@better-auth/passkey": "^1.7.1",
    "@better-auth/oauth-provider": "^1.7.1",
    "probe-image-size": "^7.4.0",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^20.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/probe-image-size": "^7.2.5",
    "pino-pretty": "^13.0.0"
  }
}
