{
  "name": "pdmux-desktop",
  "version": "0.12.1",
  "description": "Desktop distribution of the pdmux development machine dashboard.",
  "author": {
    "name": "PODOSOFT",
    "email": "podosoft-dev@users.noreply.github.com"
  },
  "homepage": "https://github.com/podosoft-dev/pdmux",
  "desktopName": "dev.podosoft.pdmux",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "package": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  },
  "build": {
    "directories": { "output": "release" },
    "appId": "dev.podosoft.pdmux",
    "productName": "pdmux",
    "executableName": "pdmux",
    "icon": "../web/static/favicon.svg",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["en", "ko"],
    "artifactName": "pdmux-${version}-${os}-${arch}.${ext}",
    "files": ["dist/**", "package.json"],
    "extraResources": [
      { "from": "resources/services/api", "to": "api" },
      { "from": "resources/services/web", "to": "web", "filter": ["**/*", "!**/*.map"] },
      { "from": "resources/bin", "to": "bin" },
      { "from": "resources/sqlite-backup.mjs", "to": "runtime/sqlite-backup.mjs" },
      { "from": "../web/static/favicon.svg", "to": "icon.svg" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "category": "Development",
      "syncDesktopName": true,
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [{ "provider": "github", "owner": "podosoft-dev", "repo": "pdmux" }]
  }
}
