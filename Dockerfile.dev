# Development image for the Bun 1.4.4 PodoKit monorepo.
FROM oven/bun:1.4.4-alpine AS manifests
WORKDIR /src
COPY . .
RUN mkdir -p /app \
    && cp package.json bun.lock bunfig.toml /app/ \
    && find . -name package.json -not -path "*/node_modules/*" \
         -exec sh -c 'mkdir -p "/app/$(dirname "$1")" && cp "$1" "/app/$1"' _ {} \;

FROM oven/bun:1.4.4-alpine

RUN apk add --no-cache git python3 make g++ ca-certificates

# The system packages and tools the API image adds (apps/api/image.extensions.sh),
# so development has what production has.
ARG TARGETARCH
COPY apps/api/image.extensions.sh /tmp/podokit/image.extensions.sh
RUN TARGETARCH="$TARGETARCH" sh /tmp/podokit/image.extensions.sh && rm -rf /tmp/podokit

WORKDIR /app
COPY --from=manifests /app ./
ARG PODOKIT_NPM_REGISTRY=""
RUN if [ -n "$PODOKIT_NPM_REGISTRY" ]; then \
      bun install --frozen-lockfile --registry "$PODOKIT_NPM_REGISTRY"; \
    else \
      bun install --frozen-lockfile; \
    fi

COPY . .
RUN if [ -d packages ]; then \
      for manifest in packages/*/package.json; do \
        [ -e "$manifest" ] || continue; \
        bun run --cwd "$(dirname "$manifest")" --if-present build; \
      done; \
    fi

EXPOSE 5001 5002
