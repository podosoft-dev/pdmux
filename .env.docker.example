# Container environment for compose.dev.yaml. Commit this example with
# development defaults only. podo dev copies it to the untracked .env.docker
# when that file is missing and fills every empty *_SECRET value with a random
# one. Put real credentials, such as OAuth or SMTP secrets, in .env.docker.
# Compose does not interpolate from these files: set container memory limits
# such as API_MEM_LIMIT=3g in the shell or the project's .env file instead.
NODE_ENV=development
PORT=5002
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=podokit
POSTGRES_PASSWORD=podokit
POSTGRES_DB=podokit
BACKEND_INTERNAL_URL=http://api:5002
# API: the web container and the gateway are the one proxy in front of it.
TRUSTED_PROXY_HOPS=1
# Web: milliseconds per server-side API call, and the /api proxy's wait for
# response headers.
# BACKEND_TIMEOUT_MS=2000
# BACKEND_PROXY_TIMEOUT_MS=30000
# podo dev sets CORS_ORIGIN and BETTER_AUTH_URL for web and api from
# .podokit/dev.json. These two serve compose.dev.yaml run without podo dev,
# such as from the devcontainer.
CORS_ORIGIN=http://pdmux.localhost,http://localhost
REDIS_HOST=redis
REDIS_PORT=6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://pdmux.localhost
ADMIN_EMAILS=admin@example.com,pdmux-e2e@example.com
AUDIT_LOG_ENABLED=true
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
API_KEYS=dev-key-please-change
LOG_LEVEL=info
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=podokit
S3_ACCESS_KEY_ID=podokit
S3_SECRET_ACCESS_KEY=podokitsecret
S3_FORCE_PATH_STYLE=true
